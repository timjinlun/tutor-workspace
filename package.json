{
  "name": "tutor-workspace",
  "productName": "记一课",
  "version": "3.5.1",
  "description": "给独立老师的本地优先桌面工作台：今天 / 学员 / 课表 / 收支。macOS 原生质感，数据存本机 SQLite。",
  "author": "Tim",
  "license": "MIT",
  "private": true,
  "main": "out/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/timjinlun/tutor-workspace"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src electron --ext .ts,.tsx",
    "pack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.tim.tutorworkspace",
    "productName": "记一课",
    "copyright": "Copyright © 2026 Tim",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "LessonLog-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "afterSign": "build/after-sign.js",
    "publish": null
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
